{
  "name": "@kijk/api",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "description": "Typed client for the Kijk API: requests, query keys, queryOptions and mutationOptions.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "kubb generate && node scripts/generate-operations.mjs ../../apps/api/src/Api/kijk_openapi.json src/generated/operations.ts && oxfmt src/generated",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:"
  },
  "devDependencies": {
    "@kijk/config": "workspace:*",
    "@kubb/plugin-fetch": "catalog:",
    "@kubb/plugin-ts": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "kubb": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    ":timezone(Europe/Berlin)"
  ],
  "assignees": ["maxstue"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "2 days",
  "rangeStrategy": "bump",
  "schedule": ["before 8am on monday"],
  "customManagers": [
    {
      "description": "Update the Railway CLI release and its checksum in the migrate-database action.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/actions/migrate-database/action\\.yml$/"],
      "matchStrings": [
        "RAILWAY_CLI_VERSION: (?<currentValue>v\\S+)\\s+RAILWAY_CLI_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "railwayapp/cli",
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on monday"],
    "commitMessageAction": "refresh"
  },
  "packageRules": [
    {
      "description": "Keep runtime compatibility requirements stable.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "commitMessageTopic": "github actions"
    },
    {
      "description": "Group Docker image updates.",
      "matchManagers": ["dockerfile"],
      "groupName": "docker images",
      "commitMessageTopic": "docker images"
    },
    {
      "description": "Group frontend package patch and minor updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "frontend packages",
      "commitMessageTopic": "frontend packages"
    },
    {
      "description": "Group backend package patch and minor updates.",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "backend packages",
      "commitMessageTopic": "backend packages"
    },
    {
      "description": "Keep frontend and backend major updates isolated for review.",
      "matchManagers": ["npm", "nuget"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the Railway CLI of the migration action and the deploy container on the same version.",
      "matchPackageNames": ["railwayapp/cli", "ghcr.io/railwayapp/cli"],
      "groupName": "railway cli",
      "commitMessageTopic": "railway cli"
    }
  ]
}

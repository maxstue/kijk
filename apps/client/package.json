{
  "name": "kijk-client",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "infisical run --project-config-dir=../.. --path=/Client -- vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:unit": "vp test run --project unit",
    "test:component": "vp test run --project component",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "infisical run --project-config-dir=../.. --path=/Client -- playwright test",
    "test:e2e:ui": "infisical run --project-config-dir=../.. --path=/Client -- playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm oxlint",
    "lint:fix": "pnpm oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "clean": "rimraf ./dist",
    "clean:dedupe": "pnpm dedupe --check"
  },

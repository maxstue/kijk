{
  "ConnectionStrings": {
    "DefaultConnection": "<from environment variable>"
  },
  "Persistence": {
    "SlowQueryLoggingEnabled": false,
    "SlowQueryLoggingThreshold": 1000
  },
  "Cors": [
    "https://kijk-app.justmax.xyz"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.IdentityModel.LoggingExtensions.IdentityLoggerAdapter ": "Warning"
      }
    }
  },
  "Sentry": {
    "Dsn": "",
    // <from environment variable> -> this needs to be done so, because otherwise sentry causes an exception
    "SendDefaultPii": false,
    "MaxRequestBodySize": "None",
    "MinimumBreadcrumbLevel": "Error",
    "MinimumEventLevel": "Warning",
    "MaxBreadcrumbs": 0,
    "AttachStackTrace": true,
    "IncludeActivityData": false,
    "Debug": false,
    "DiagnosticLevel": "Error",
    "EnableTracing": false,
    "TracesSampleRate": 0,
    "EnableLogs": false
  }
}

{
  "Auth": {
    "Authority": "<from user-secrets or environment variable>",
    "SecretKey": "<from user-secrets or environment variable>",
    "AuthorizedParties": ["<from user-secrets or environment variable>"],
    "ClockSkewInSeconds": 5
  },
  "OpenApi": {
    "Token": "<from user-secrets or environment variable>"
  },
  "AllowedHosts": "*",
  "Sentry": {
    "Dsn": ""
  },
  "PostHog": {
    "ProjectToken": ""
  },
  "FeatureFlags": {
    "FinancesFallback": true,
    "AiImportFallback": true,
    "RefreshInterval": "00:01:00"
  },
  "Telemetry": {
    "FeedbackSurveyId": ""
  },
  "Serilog": {
    "LevelSwitches": {
      "ConsoleSwitch": "Information"
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%openapi%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%scalar%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%/favicon%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestMethod like '%OPTIONS%'"
        }
      }
    ],
    "Using": ["Serilog.Sinks.Console", "Serilog.Expressions"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff}] [{Level:u4}] [{SourceContext}] {CorrelationId} {Message}{NewLine}{Exception}",
          "levelSwitch": "$ConsoleSwitch"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
